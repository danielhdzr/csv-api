# Copia este archivo a .env y cambia los valores. Docker Compose lo lee automáticamente.
# Nota: POSTGRES_USER/PASSWORD/DB solo se aplican al crear el volumen por primera vez;
# para cambiarlos después hay que borrar los datos con `docker compose down -v`.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ventas
DB_PORT=5433
API_PORT=8000
